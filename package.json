{
  "name": "electronjs-app",
  "version": "1.0.0",
  "description": "Aplikasi Desktop Electron dengan Vue 3",
  "homepage": "https://github.com/yourusername/electronjs-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/electronjs-app.git"
  },
  "author": "Your Name",
  "license": "MIT",
  "keywords": [
    "electron",
    "vue",
    "desktop",
    "application"
  ],
  "build": {
    "appId": "com.yourcompany.electronjsapp",
    "productName": "ElectronJS App",
    "copyright": "Copyright © 2026 Your Company",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "preview": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "dependencies": {
    "electron-store": "^12.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}